<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsLibrary>true</IsLibrary>
    <PackageId>PolarSharp.Reporting.Marten</PackageId>
    <Version>1.0.0</Version>
    <!-- Marked IsPackable=false 2026-05-20: package body is a scaffold per its XML doc deferral marker (real implementation lands in a follow-up phase). Flip back to true when the implementation lands so the empty assembly never reaches NuGet. -->
    <IsPackable>false</IsPackable>
    <Authors>Molls and Hersh, LLC</Authors>
    <Description>Marten-backed event-sourced reporting events (Postgres-only).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mollsandhersh/Polar.sh_Nuget</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mollsandhersh/Polar.sh_Nuget</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>polar;reporting;marten;eventsourcing;postgresql;saas</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>PolarSharp.Reporting.Marten</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolarSharp.Reporting\PolarSharp.Reporting.csproj" />
    <PackageReference Include="Marten" />
  </ItemGroup>

</Project>
