<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsLibrary>true</IsLibrary>
    <PackageId>PolarSharp.EcommerceStorefronts.Polar.WebComponents</PackageId>
    <Version>1.0.0</Version>
    <!-- Marked IsPackable=false 2026-05-19: package has zero hand-written source files. Flip back to true once the v1.4.0 implementation lands so the empty assembly never reaches a NuGet feed. -->
    <IsPackable>false</IsPackable>
    <Authors>Molls and Hersh, LLC</Authors>
    <Description>Bridge: wires the WC SignalR hub into PolarSharp's catalog + wallet + identity providers.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mollsandhersh/Polar.sh_Nuget</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mollsandhersh/Polar.sh_Nuget</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>polar;ecommerce;storefronts;bridge;webcomponents;saas</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>PolarSharp.EcommerceStorefronts.Polar.WebComponents</RootNamespace>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolarSharp.EcommerceStorefronts.WebComponents.SignalRHub\PolarSharp.EcommerceStorefronts.WebComponents.SignalRHub.csproj" />
    <ProjectReference Include="..\PolarSharp.EcommerceStoreManagement\PolarSharp.EcommerceStoreManagement.csproj" />
    <ProjectReference Include="..\PolarSharp.PrepaidWallets\PolarSharp.PrepaidWallets.csproj" />
    <ProjectReference Include="..\PolarSharp.MultiTenant.Identity\PolarSharp.MultiTenant.Identity.csproj" />
  </ItemGroup>

</Project>
